# Copy to .env for local development. Never put a real secret in a committed file.
# This application needs NO broker credential: the Python engine is simulation-only.

# Builder.io public key (public by design, optional; leave the placeholder if unused)
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
# Message returned by GET /api/ping (template example)
PING_MESSAGE="ping pong"

# Optional: Python quant API location used by the Vite dev proxy and `pnpm start`
# QUANT_API_URL=http://127.0.0.1:8765
